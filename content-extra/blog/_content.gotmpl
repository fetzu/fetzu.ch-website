{{/* Builds the /blog/YYYY/, /blog/YYYY/MM/ and /blog/YYYY/MM/DD/ archive pages. */}}
{{/* Content adapters cannot see the site's page collection (SEE https://gohugo.io/content-management/content-adapters/), so we grub the dates straight out of the file names (2026-08-19-name.md) or, failing that, the front matter. */}}
{{/* NOTE: drafts are skipped, so their archive pages will not exist under "hugo server -D" either. */}}

{{/* Collect every year, year/month and year/month/day that has at least one post */}}
{{ $archives := dict }}
{{ range $f := os.ReadDir "content/blog" }}
  {{ $name := $f.Name }}
  {{ if and (not $f.IsDir) (strings.HasSuffix $name ".md") (ne $name "_index.md") }}
    {{ $raw := os.ReadFile (printf "content/blog/%s" $name) }}
    {{ if not (findRE `(?m)^draft:\s*true\s*$` $raw 1) }}
      {{/* The 2026-08-19-name.md convention names the date; front matter is the fallback */}}
      {{ $m := findRESubmatch `^(\d{4})-(\d{2})-(\d{2})-` $name 1 }}
      {{ if not $m }}
        {{ $m = findRESubmatch `(?m)^date:\s*['"]?(\d{4})-(\d{2})-(\d{2})` $raw 1 }}
      {{ end }}
      {{ if $m }}
        {{ $g := index $m 0 }}
        {{ $y := index $g 1 }}
        {{ $mo := index $g 2 }}
        {{ $d := index $g 3 }}
        {{ $archives = merge $archives (dict
             $y true
             (printf "%s/%s" $y $mo) true
             (printf "%s/%s/%s" $y $mo $d) true) }}
      {{ end }}
    {{ end }}
  {{ end }}
{{ end }}

{{/* One section page per archive, rendered by layouts/blog-archive/list.html */}}
{{ range $path, $_ := $archives }}
  {{ $parts := split $path "/" }}
  {{ $title := printf "Posts from %s" (index $parts 0) }}
  {{ $date := time.AsTime (printf "%s-01-01" (index $parts 0)) }}
  {{ if eq (len $parts) 2 }}
    {{ $date = time.AsTime (printf "%s-%s-01" (index $parts 0) (index $parts 1)) }}
    {{ $title = printf "Posts from %s" ($date.Format "January 2006") }}
  {{ else if eq (len $parts) 3 }}
    {{ $date = time.AsTime (printf "%s-%s-%s" (index $parts 0) (index $parts 1) (index $parts 2)) }}
    {{ $title = printf "Posts from %s" ($date.Format "2 January 2006") }}
  {{ end }}
  {{ $.AddPage (dict
       "path" $path
       "kind" "section"
       "type" "blog-archive"
       "title" $title
       "dates" (dict "date" $date)
       "outputs" (slice "html")
       "params" (dict "archive" $path)) }}
{{ end }}
